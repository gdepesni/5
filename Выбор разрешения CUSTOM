<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Выбор разрешения экрана</title>
    <style>
        /* Оформление модального окна */
        #modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); display: flex;
            justify-content: center; align-items: center; z-index: 9999;
        }
        .modal-card {
            background: #fff; padding: 30px; border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            width: 300px; text-align: left;
        }
        .modal-card h2 { margin-top: 0; font-size: 1.2em; color: #333; }
        
        /* Стилизация радиокнопок (аналог JRadioButton) */
        .radio-group { margin: 20px 0; }
        .radio-item { margin-bottom: 12px; display: flex; align-items: center; cursor: pointer; }
        .radio-item input { margin-right: 10px; width: 18px; height: 18px; cursor: pointer; }
        
        button {
            width: 100%; padding: 12px; border: none; border-radius: 6px;
            background: #28a745; color: white; font-weight: bold; cursor: pointer;
        }
        button:hover { background: #218838; }

        /* Контейнер "приложения" */
        #main-app {
            margin: 50px auto; border: 3px solid #007bff;
            background: #e9ecef; display: none; transition: all 0.3s;
        }
    </style>
</head>
<body>

<!-- Диалоговое окно (JRadioButton style) -->
<div id="modal-overlay">
    <div class="modal-card">
        <h2>Выберите разрешение:</h2>
        <div class="radio-group">
            <label class="radio-item">
                <input type="radio" name="res" value="800x600"> 800 x 600
            </label>
            <label class="radio-item">
                <input type="radio" name="res" value="1200x600" checked> 1200 x 600
            </label>
            <label class="radio-item">
                <input type="radio" name="res" value="1920x1080"> 1920 x 1080
            </label>
        </div>
        <button id="launch-btn">ОК</button>
    </div>
</div>

<!-- Окно приложения -->
<div id="main-app">
    <div style="padding: 20px; text-align: center;">
        <h1>Приложение запущено</h1>
        <p id="size-info"></p>
    </div>
</div>

<script>
    const overlay = document.getElementById('modal-overlay');
    const app = document.getElementById('main-app');
    const launchBtn = document.getElementById('launch-btn');
    const sizeInfo = document.getElementById('size-info');

    launchBtn.onclick = function() {
        // Находим выбранную радиокнопку
        const selectedRadio = document.querySelector('input[name="res"]:checked');
        
        if (selectedRadio) {
            const [width, height] = selectedRadio.value.split('x');

            // 1. Скрываем диалог
            overlay.style.display = 'none';

            // 2. Настраиваем и показываем "окно" приложения
            app.style.display = 'block';
            app.style.width = width + 'px';
            app.style.height = height + 'px';
            
            // 3. Выводим информацию
            sizeInfo.innerText = `Текущий размер окна: ${width} x ${height}`;
            alert(`Выбрано разрешение: ${width}x${height}`);
        }
    };
</script>

</body>
</html>
